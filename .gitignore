# ============================================================
# ASP.NET Core / .NET 10 - Visual Studio
# ============================================================
# Archivo recomendado para una API ASP.NET Core/.NET 10.
# NO ignorar archivos fuente, .sln, .csproj, appsettings*.json
# (excepto archivos locales que contengan secretos).

# ------------------------------------------------------------
# Visual Studio - configuración y caché local
# ------------------------------------------------------------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# ------------------------------------------------------------
# .NET - compilación y artefactos generados
# ------------------------------------------------------------
**/bin/
**/obj/
**/out/
**/artifacts/
**/.artifacts/

# Archivos temporales de compilación
*.dll
*.exe
*.pdb
*.cache
*.ilk
*.obj
*.iobj
*.ipdb
*.pch
*.tmp
*.log
*.tlog
*.binlog

# ------------------------------------------------------------
# NuGet
# ------------------------------------------------------------
*.nupkg
*.snupkg
packages/
**/packages/
*.nuget.props
*.nuget.targets

# No subir caché local de NuGet si aparece dentro del proyecto
.nuget/

# ------------------------------------------------------------
# ASP.NET Core - secretos y configuración local
# ------------------------------------------------------------
# User Secrets normalmente viven fuera del proyecto, pero
# evitamos archivos de configuración locales que puedan contener
# credenciales si el equipo los utiliza.
appsettings.Development.local.json
appsettings.Local.json
appsettings.*.local.json

# Variables de entorno / secretos locales
.env
.env.*
!.env.example
!.env.template

# ------------------------------------------------------------
# Certificados y claves locales
# ------------------------------------------------------------
*.pfx
*.p12
*.key
*.pem

# IMPORTANTE:
# Si un certificado es parte REAL del proyecto y debe versionarse,
# elimine la regla correspondiente y documente el manejo seguro.

# ------------------------------------------------------------
# ASP.NET Core - archivos de desarrollo/publicación
# ------------------------------------------------------------
wwwroot/_framework/
publish/
Publish/
PublishScripts/
*.publish.xml
*.pubxml
*.publishproj
*.publishsettings

# ------------------------------------------------------------
# Logs y archivos temporales de la aplicación
# ------------------------------------------------------------
logs/
Logs/
**/logs/
**/Logs/
*.log
*.trace

# Archivos temporales
*.tmp
*.temp
~$*
*~

# ------------------------------------------------------------
# Cobertura de pruebas
# ------------------------------------------------------------
TestResults/
**/TestResults/
coverage/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# ------------------------------------------------------------
# Tests / herramientas de análisis
# ------------------------------------------------------------
*.trx
BenchmarkDotNet.Artifacts/
OpenCover/
NCrunch_*
.ncrunch*
*.dotCover

# ------------------------------------------------------------
# Base de datos local / archivos generados
# ------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# SQL Server LocalDB
*.mdf
*.ldf
*.ndf

# ------------------------------------------------------------
# Rider / JetBrains (si algún integrante usa Rider)
# ------------------------------------------------------------
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# ------------------------------------------------------------
# VS Code - solo archivos personales
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

.history/

# ------------------------------------------------------------
# Sistema operativo
# ------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory

# ------------------------------------------------------------
# Node.js / frontend, si existe dentro de la solución
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# Azure / herramientas de desarrollo
# ------------------------------------------------------------
.azure/
.azuredevops/

# ------------------------------------------------------------
# F# / herramientas adicionales
# ------------------------------------------------------------
**/.ionide/
**/.mfractor/
**/__pycache__/
*.pyc

# ============================================================
# ARCHIVOS QUE SÍ DEBEN VERSIONARSE
# ============================================================
# .sln
# *.csproj
# *.cs
# appsettings.json
# appsettings.Development.json (SOLO si no contiene secretos)
# Directory.Build.props
# Directory.Build.targets
# Directory.Packages.props
# global.json
# NuGet.Config (SOLO si no contiene credenciales)
# README.md
# .editorconfig
# Dockerfile
# docker-compose*.yml (sin secretos)
# .vscode/settings.json
# .vscode/launch.json
# ============================================================
